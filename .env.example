# Copy to .env for local overrides. Never commit a filled-in .env.
# Local runs do not need Azure credentials.

NL_ENV=dev
NL_STORAGE_MODE=local
NL_CATALOG_MODE=local
NL_LOCAL_ROOT=data/lake
NL_LANDING=data/sample
NL_LOG_DIR=data/logs
NL_STORAGE_ACCOUNT=stnlretaildev
NL_CATALOG=northline_dev
NL_ALERT_WEBHOOK_URL=

# GitHub environment secrets for CD. Leave unset to skip deployment.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_ID_PROD=
AZURE_CLIENT_SECRET_PROD=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HOST_PROD=
DATABRICKS_TOKEN_PROD=
SYNAPSE_SQL_PASSWORD=

# Databricks secret scope nl-kv-<env> is backed by Key Vault.
# Secret names expected by linked services: databricks-token, synapse-sql-password.
