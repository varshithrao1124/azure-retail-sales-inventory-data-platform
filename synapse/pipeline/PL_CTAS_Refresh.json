{
  "name": "PL_CTAS_Refresh",
  "properties": {
    "description": "Refresh dedicated-pool gold from serverless OPENROWSET views. Run after the Databricks medallion job. Not executed in this repository.",
    "activities": [
      {
        "name": "Refresh_Dedicated_Gold",
        "type": "Script",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "linkedServiceName": {
          "referenceName": "LS_Synapse_Dedicated",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": "EXEC gold.usp_refresh_from_lake;"
            }
          ]
        }
      }
    ]
  }
}
